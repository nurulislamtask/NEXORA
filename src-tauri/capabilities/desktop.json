{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only permissions (sticky windows, clipboard, restart)",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main",
    "sticky-*"
  ],
  "permissions": [
    "process:allow-restart",
    "clipboard-manager:allow-read-text",
    "core:window:allow-set-always-on-top",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-set-focus",
    "core:default",
    "core:event:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}